# Copie para .env e ajuste antes de subir em qualquer ambiente que não seja local.
# O docker compose lê este arquivo automaticamente.

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=troque-esta-senha

# Segredo HS256 do JWT: mínimo 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# Origens permitidas no CORS do gateway (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Notificações automáticas (tarefa criada/concluída) via task-service -> notification-service
NOTIFICATIONS_ENABLED=true
